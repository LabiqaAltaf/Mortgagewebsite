/* ================================================================== */
/*  HOME PAGE STYLES                                                  */
/*  Clean, single-source-of-truth stylesheet for the homepage.        */
/*  Reproduces the reference design: minimal, premium, editorial,     */
/*  mortgage/real-estate. Bootstrap supplies the grid; these rules     */
/*  tune colors, proportions, spacing, typography and responsive.     */
/* ================================================================== */

/* ---- Consistent section rhythm (~70px vertical breathing room) ---- */
.section {
  padding-top: clamp(56px, 7vw, 72px);
  padding-bottom: clamp(56px, 7vw, 72px);
}

/* ================================================================== */
/*  NAVBAR â€” extremely minimal: tiny blue logo left, Log in + CTA     */
/* ================================================================== */
.site-nav {
  position: sticky;
  top: 0;
  z-index: 1030;
  background: rgba(255, 255, 255, 0.95);
  border-bottom: 1px solid var(--border);
}
.site-nav .nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 68px;
}
.site-logo {
  display: inline-flex;
  align-items: center;
  gap: 9px;
}
.logo-mark {
  width: 30px;
  height: 30px;
  display: block;
  flex-shrink: 0;
}
.logo-word {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  line-height: 1.05;
}
.logo-word-sub {
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: var(--gray);
}
.logo-word-main {
  font-size: 13px;
  font-weight: 800;
  color: var(--dark);
  letter-spacing: 0.01em;
}
.site-nav .nav-actions {
  display: flex;
  align-items: center;
  gap: 20px;
}
.nav-login {
  color: var(--ink);
  font-size: 0.9rem;
  font-weight: 600;
  transition: color 0.2s ease;
}
.nav-login:hover {
  color: var(--blue);
}
.nav-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 138px;
  padding: 10px 22px;
  border-radius: 999px;
  background: var(--blue);
  color: #fff;
  font-size: 0.88rem;
  font-weight: 700;
  line-height: 1;
  transition: background 0.25s ease, transform 0.2s ease;
}
.nav-cta:hover {
  background: var(--blue-dark);
  color: #fff;
  transform: translateY(-1px);
}

/* ================================================================== */
/*  HERO â€” one composed section: light bg, big headline, accent,      */
/*  two pills, then a wide architectural house scene with trees.      */
/* ================================================================== */
.hero {
  position: relative;
  background: #f5fbff;
  text-align: center;
  padding: clamp(40px, 4.2vw, 54px) 0 0;
  overflow: hidden;
}
.hero .hero-inner {
  position: relative;
  z-index: 3;
  width: 100%;
  max-width: var(--container);
  margin: 0 auto;
  padding: 0 20px;
}
.hero-title {
  margin: 0;
  color: var(--dark);
  text-transform: uppercase;
  letter-spacing: -0.01em;
  line-height: 1.05;
  font-size: clamp(2.7rem, 5.6vw, 4.9rem);
}
/* FIRST LINE "EXPERTS IN GETTING" â€” visibly lighter / medium */
.hero-title-light {
  font-weight: 500;
}
/* SECOND LINE "YOU APPROVED" â€” heavy, visually dominant */
.hero-title-heavy {
  font-weight: 900;
}
.hero-title-line {
  display: block;
}
/* Keep the headline locked to exactly two lines on desktop */
@media (min-width: 768px) {
  .hero-title-line {
    white-space: nowrap;
  }
}
/* "YOU APPROVED" is visually stronger/bolder */
.hero-line-two {
  color: var(--dark);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  line-height: 1.04;
}
.hero-line-two .hero-highlight {
  position: relative;
  display: inline-block;
  padding: 0 0.06em;
}
/* pale-blue band behind the lower part of "YOU APPROVED" */
.hero-line-two .hero-highlight::after {
  content: '';
  position: absolute;
  left: -0.04em;
  right: -0.04em;
  bottom: 0.02em;
  height: 0.28em;
  background: #d6ecff;
  border-radius: 0.3em;
  opacity: 0.85;
  z-index: -1;
}
/* hand-drawn blue scribble accent near the upper-right of "YOU APPROVED" */
.hero-scribble {
  display: block;
  flex-shrink: 0;
  width: 64px;
  height: 40px;
  margin-left: 8px;
  transform: translateY(-16px) translateX(2px);
  pointer-events: none;
}
.hero-sub {
  margin: 18px auto 0;
  max-width: 640px;
  color: var(--blue);
  font-size: 1.06rem;
  font-weight: 400;
  line-height: 1.6;
}
.hero-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 14px;
  margin-top: 22px;
}
.btn-hero-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 28px;
  border-radius: 999px;
  background: var(--blue);
  color: #fff;
  font-weight: 700;
  font-size: 0.98rem;
  line-height: 1;
  transition: background 0.25s ease, transform 0.2s ease;
}
.btn-hero-primary:hover {
  background: var(--blue-dark);
  color: #fff;
  transform: translateY(-2px);
}
.btn-hero-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 28px;
  border-radius: 999px;
  background: #fff;
  border: 1px solid var(--border);
  color: var(--dark);
  font-weight: 600;
  font-size: 0.98rem;
  line-height: 1;
  transition: border-color 0.25s ease, color 0.25s ease, transform 0.2s ease;
}
.btn-hero-secondary:hover {
  border-color: var(--blue);
  color: var(--blue);
  transform: translateY(-2px);
}

/* ---- Hero visual: the three-house image sits immediately above the
   review section, spanning the same main content width as the reference.
   Full width of the container, natural height - no banner crop, no blur. */
.hero-visual {
  width: 100%;
  max-width: 1050px;
  margin: 26px auto 0;
  padding-inline: 20px;
}
.hero-visual img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: cover;
  border: none;
  border-radius: 0;
}

/* ================================================================== */
/*  GOOGLE REVIEWS â€” reference composition (pixel-matched scale).     */
/*  One centered grid container, two columns, small type hierarchy,   */
/*  fixed gap system. No blue lines, no cards, no decorations.        */
/* ================================================================== */
.review-section {
  position: relative;
  z-index: 1;
  background: var(--white);
  padding: 58px 0 60px;
}
.review-section-inner {
  width: 100%;
  max-width: 1024px;
  margin: 0 auto;
  padding-inline: 32px;
  display: grid;
  grid-template-columns: minmax(0, 30%) minmax(0, 1fr);
  column-gap: 60px;
  align-items: start;
}

/* ---- LEFT: Google Reviews + stats (one flex flow, fixed gaps) ---- */
.review-left {
  display: flex;
  flex-direction: column;
}
.google-review-label {
  display: block;
  margin-bottom: 35px;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 1px;
  text-transform: uppercase;
  line-height: 1.2;
  color: var(--blue);
}
.stats-list {
  display: flex;
  flex-direction: column;
  gap: 40px;
}
.stat-value {
  color: var(--dark);
  font-size: 28px;
  font-weight: 400;
  line-height: 1;
  letter-spacing: -0.5px;
}
.stat-label {
  margin-top: 8px;
  max-width: 200px;
  color: #667085;
  font-size: 11px;
  line-height: 1.35;
  font-weight: 400;
}

/* ---- RIGHT: heading -> paragraph -> client -> chevrons ---- */
.review-right {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.review-heading .google-reviews-title {
  margin: 0;
  font-size: 28px;
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -0.5px;
}
.review-title-line {
  display: block;
}
.review-description {
  margin-top: 24px;
  max-width: 560px;
}
.review-description .review-paragraph {
  margin: 0;
  color: #667085;
  font-size: 12px;
  font-weight: 400;
  line-height: 1.55;
}
.review-client {
  margin-top: 20px;
  border-top: 1px solid #e5e5e5;
  padding-top: 14px;
}
.review-name {
  font-size: 13px;
  font-weight: 600;
  line-height: 1.2;
  color: var(--dark);
}
.review-location {
  margin-top: 3px;
  font-size: 11px;
  font-weight: 400;
  color: #667085;
}
/* tiny plain <  > text chevrons, right side of the review column */
.review-controls {
  margin-top: 18px;
  align-self: flex-end;
  display: flex;
  align-items: center;
  gap: 16px;
}
.review-chevron {
  display: inline-block;
  width: 14px;
  height: 14px;
  color: var(--gray-light);
  font-size: 12px;
  font-weight: 400;
  line-height: 1;
  cursor: pointer;
  user-select: none;
  transition: color 0.15s ease;
}
.review-chevron:hover {
  color: var(--blue);
}

/* ---- Responsive ---- */
@media (max-width: 991.98px) {
  .review-section-inner {
    grid-template-columns: 1fr;
    row-gap: 40px;
  }
}
@media (max-width: 767.98px) {
  .review-heading .google-reviews-title {
    font-size: 24px;
  }
}

/* ================================================================== */
/*  APPROVAL STEPS â€” two columns: intro left, stacked cards right     */
/* ================================================================== */
.steps-section {
  background: var(--white);
}
.steps-intro .eyebrow {
  margin-bottom: 16px;
}
.steps-intro .sec-sub {
  margin-top: 20px;
}
.steps-intro .sec-sub + .mt-4 {
  margin-top: 28px;
}
.steps-right {
  display: flex;
  flex-direction: column;
  gap: 18px;
}
/* section separation */
.section-separation {
  height: 1px;
  background: var(--border);
  margin: 40px 0;
}
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
  flex-shrink: 0;
}
.get-touch-body {
  flex: 1;
}
.get-touch-title {
  display: block;
  font-weight: 700;
  font-size: 1.1rem;
}
.get-touch-text {
  font-size: 0.9rem;
  opacity: 0.85;
  margin-top: 2px;
  display: block;
}
.get-touch-arrow {
  font-size: 1.25rem;
  opacity: 0.85;
}
/* step cards - right column */
.step-card {
  flex-direction: column;
  gap: 10px;
  background: var(--blue-soft);
  border: 1px solid #e3f0ff;
  border-radius: 12px;
  padding: 18px 20px;
  height: auto;
}
.step-icon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: #fff;
  color: var(--blue);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  flex-shrink: 0;
  margin-right: 8px;
}
.step-body {
  flex: 1;
}
.step-num {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--blue);
  margin-bottom: 4px;
}
.step-body h3 {
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--dark);
  margin: 0;
}
.step-body p {
  margin: 4px 0 0;
  color: var(--gray);
  font-size: 0.85rem;
  line-height: 1.4;
}

/* ================================================================== */
/*  APPROACH + REAL interior image composition                        */
/* ================================================================== */
.approach-section {
  background: var(--white);
}
.approach-copy {
  text-align: center;
  max-width: 720px;
  margin: 0 auto;
}
.approach-copy .eyebrow {
  justify-content: center;
}
.approach-copy-sub {
  margin: 18px auto 0;
}
/* tiny rounded pills */
.approach-words {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  margin-top: 30px;
}
.approach-words span {
  padding: 8px 18px;
  border-radius: 999px;
  background: var(--blue-soft);
  border: 1px solid #e3f0ff;
  color: var(--blue);
  font-weight: 700;
  font-size: 0.85rem;
}
/* interior image composition: wide rounded image + overlapping card */
/* + small blue floating CTA                                          */
.collage {
  position: relative;
  margin-top: 56px;
}
.collage-large {
  border-radius: 26px;
  overflow: hidden;
}
.collage-large img {
  display: block;
  width: 100%;
  height: clamp(380px, 48vw, 540px);
  object-fit: cover;
}
.collage-small {
  position: absolute;
  bottom: -46px;
  right: 22px;
  width: 220px;
  border-radius: 18px;
  overflow: hidden;
  border: 6px solid #fff;
  box-shadow: var(--shadow);
}
.collage-small img {
  display: block;
  width: 100%;
  height: 165px;
  object-fit: cover;
}
.collage-badge {
  position: absolute;
  bottom: 26px;
  left: 26px;
  background: var(--blue);
  color: #fff;
  border-radius: 16px;
  padding: 16px 20px;
  font-weight: 800;
  line-height: 1.2;
  box-shadow: var(--shadow-sm);
}
.collage-badge small {
  display: block;
  font-weight: 600;
  font-size: 0.72rem;
  opacity: 0.85;
  margin-bottom: 4px;
}

/* ================================================================== */
/*  BAD CREDIT â€” bright clean blue banner with decorative circles     */
/* ================================================================== */
.badcredit-section {
  background: var(--white);
  padding: clamp(30px, 4vw, 44px) 0;
}
.badcredit-banner {
  position: relative;
  background: #1769ff;
  color: #fff;
  border-radius: 28px;
  text-align: center;
  padding: clamp(60px, 7vw, 88px) 24px;
  overflow: hidden;
}
.badcredit-banner .deco::before,
.badcredit-banner .deco::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  pointer-events: none;
}
.badcredit-banner .deco::before {
  width: 300px;
  height: 300px;
  top: -140px;
  right: -90px;
}
.badcredit-banner .deco::after {
  width: 240px;
  height: 240px;
  bottom: -120px;
  left: -70px;
}
.bc-eyebrow {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 16px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.bc-title {
  position: relative;
  z-index: 1;
  margin: 18px 0 10px;
  font-size: clamp(2rem, 4vw, 2.8rem);
  font-weight: 800;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: -0.01em;
}
.bc-text {
  position: relative;
  z-index: 1;
  max-width: 560px;
  margin: 0 auto;
  color: rgba(255, 255, 255, 0.92);
}
.bc-actions {
  position: relative;
  z-index: 1;
  margin-top: 28px;
}
.btn-white {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 13px 30px;
  border: none;
  border-radius: 999px;
  background: #fff;
  color: var(--blue);
  font-weight: 700;
  font-size: 1rem;
  line-height: 1;
  transition: background 0.25s ease, color 0.25s ease, transform 0.2s ease;
}
.btn-white:hover {
  background: var(--blue-soft);
  color: var(--blue);
  transform: translateY(-2px);
}

/* ================================================================== */
/*  REASONS â€” 2x2 compact pale-blue cards                             */
/* ================================================================== */
.reasons-section {
  background: var(--white);
}
.reasons-head {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 44px;
}
.reasons-head .eyebrow {
  justify-content: center;
}
.reasons-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}
.reason-card {
  display: flex;
  align-items: flex-start;
  gap: 18px;
  background: var(--blue-soft);
  border: 1px solid #e3f0ff;
  border-radius: 20px;
  padding: 26px;
}
.reason-icon {
  flex-shrink: 0;
  width: 50px;
  height: 50px;
  border-radius: 14px;
  background: var(--blue);
  color: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
}
.reason-card h3 {
  margin: 0 0 8px;
  font-size: 1.12rem;
  font-weight: 800;
  color: var(--dark);
}
.reason-card p {
  margin: 0;
  color: var(--gray);
  font-size: 0.94rem;
}

/* ================================================================== */
/*  EXPERTS â€” subtle light-blue section, 4-col grid                   */
/* ================================================================== */
.experts-section {
  background: var(--blue-mist);
}
.experts-head {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 44px;
}
.experts-head .eyebrow {
  justify-content: center;
}
.experts-head .sec-sub {
  margin: 18px auto 0;
}
.expert-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 14px 14px 20px;
  text-align: center;
  height: 100%;
}
.expert-photo {
  border-radius: 14px;
  overflow: hidden;
  aspect-ratio: 1 / 1;
  margin-bottom: 16px;
}
.expert-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.expert-card h3 {
  margin: 0 0 4px;
  font-size: 1.05rem;
  font-weight: 800;
  color: var(--dark);
}
.expert-card .expert-role {
  margin: 0;
  color: var(--blue);
  font-size: 0.86rem;
  font-weight: 600;
}

/* ================================================================== */
/*  CLIENT REVIEWS â€” 4 compact cards horizontally                     */
/* ================================================================== */
.testimonials-section {
  background: var(--white);
}
.testimonials-head {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 44px;
}
.testimonials-head .eyebrow {
  justify-content: center;
}
.t-card {
  height: 100%;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 24px;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
}
.t-stars {
  display: flex;
  gap: 3px;
  color: #ffb400;
  font-size: 0.9rem;
  margin-bottom: 12px;
}
.t-text {
  flex: 1;
  color: var(--ink);
  font-size: 0.94rem;
}
.t-person {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid var(--border);
}
.t-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  object-fit: cover;
}
.t-name {
  font-weight: 700;
  color: var(--dark);
  font-size: 0.96rem;
  line-height: 1.2;
}
.t-info {
  color: var(--gray);
  font-size: 0.8rem;
}

/* ================================================================== */
/*  POPULAR LENDERS â€” light blue section, small white pills           */
/* ================================================================== */
.lenders-section {
  background: var(--blue-mist);
}
.lenders-head {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 40px;
}
.lenders-head .eyebrow {
  justify-content: center;
}
.lenders-head .sec-sub {
  margin: 18px auto 0;
}
.lenders-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14px;
}
.lender-item {
  padding: 12px 26px;
  border-radius: 999px;
  background: #fff;
  border: 1px solid var(--border);
  color: var(--ink);
  font-weight: 700;
  font-size: 1rem;
  box-shadow: var(--shadow-sm);
  transition: color 0.2s ease, border-color 0.2s ease;
}
.lender-item:hover {
  color: var(--blue);
  border-color: var(--blue);
}

/* ================================================================== */
/*  FINAL CTA â€” large rounded white card with generous padding        */
/* ================================================================== */
.final-cta-section {
  background: var(--white);
}
.final-cta-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: stretch;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 28px;
  overflow: hidden;
  box-shadow: var(--shadow);
}
.final-cta-card .cta-media {
  position: relative;
  min-height: 340px;
}
.final-cta-card .cta-media img {
  width: 100%;
  height: 100%;
  min-height: 340px;
  object-fit: cover;
}
.final-cta-card .cta-content {
  padding: 52px 46px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.final-cta-card .cta-title {
  margin: 0 0 18px;
  font-size: clamp(1.6rem, 3vw, 2.2rem);
}
.final-cta-card .cta-content .sec-sub {
  margin: 0;
}
.final-cta-card .cta-content .mt-4 {
  margin-top: 28px;
}

/* ================================================================== */
/*  FOOTER â€” clean and light                                          */
/* ================================================================== */
.footer {
  background: #f6f9ff;
  border-top: 1px solid var(--border);
  padding: 60px 0 0;
}
.footer .footer-brand {
  display: inline-flex;
  align-items: center;
  gap: 9px;
}
.mm-mark {
  width: 32px;
  height: 32px;
  display: block;
}
.mm-wordmark {
  display: flex;
  flex-direction: column;
  line-height: 1.05;
}
.mm-w1 {
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: var(--gray);
}
.mm-w2 {
  font-size: 13px;
  font-weight: 800;
  color: var(--dark);
}
.footer .footer-desc {
  margin: 16px 0 0;
  max-width: 320px;
  color: var(--gray);
  font-size: 0.95rem;
}
.footer h4 {
  font-size: 0.95rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--dark);
  margin-bottom: 18px;
}
.footer .footer-links,
.footer .footer-contact {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 11px;
}
.footer .footer-links a {
  color: var(--ink);
  font-size: 0.95rem;
  font-weight: 500;
  transition: color 0.2s ease;
}
.footer .footer-links a:hover {
  color: var(--blue);
}
.footer .footer-contact li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  color: var(--ink);
  font-size: 0.95rem;
}
.footer .footer-contact i {
  color: var(--blue);
  margin-top: 3px;
}
.footer .footer-social {
  display: flex;
  gap: 10px;
  margin-top: 20px;
}
.footer .footer-social a {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: 1px solid var(--border);
  background: #fff;
  color: var(--ink);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}
.footer .footer-social a:hover {
  background: var(--blue);
  border-color: var(--blue);
  color: #fff;
}
.footer-legal {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 8px;
  border-top: 1px solid var(--border);
  margin-top: 44px;
  padding: 20px 0 24px;
  color: var(--gray);
  font-size: 0.82rem;
}

/* ================================================================== */
/*  RESPONSIVE                                                        */
/* ================================================================== */
@media (max-width: 991.98px) {
  .site-nav .nav-inner {
    height: 64px;
  }
  .hero .hero-visual img {
    height: auto;
  }
  .collage-small {
    width: 190px;
  }
}
@media (max-width: 767.98px) {
  .hero {
    padding-top: clamp(42px, 8vw, 54px);
  }
  .hero-title {
    font-size: clamp(2.1rem, 8vw, 2.9rem);
    letter-spacing: -0.01em;
  }
  .hero-scribble {
    width: 52px;
    height: 34px;
    margin-left: 4px;
    transform: translateY(-9px) translateX(1px);
  }
  .hero .hero-visual img {
    height: auto;
  }
  .hero-actions {
    flex-direction: column;
    align-items: stretch;
  }
  .btn-hero-primary,
  .btn-hero-secondary {
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
  }
  .reasons-grid {
    grid-template-columns: 1fr;
  }
  .collage-small {
    width: 150px;
    right: 12px;
    bottom: -34px;
  }
  .collage-small img {
    height: 130px;
  }
  .collage-badge {
    left: 16px;
    bottom: 18px;
    padding: 12px 16px;
  }
  .final-cta-card {
    grid-template-columns: 1fr;
  }
  .final-cta-card .cta-media {
    min-height: 0;
  }
  .final-cta-card .cta-media img {
    min-height: 220px;
    height: 240px;
  }
}
@media (max-width: 575.98px) {
  .site-nav .nav-actions {
    gap: 12px;
  }
  .nav-cta {
    min-width: 0;
    padding: 9px 14px;
    font-size: 0.85rem;
  }
  .logo-mark {
    width: 24px;
    height: 24px;
  }
  .logo-word-main {
    font-size: 11px;
  }
  .hero .hero-visual img {
    height: auto;
  }
}







