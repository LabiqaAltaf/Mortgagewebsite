# Copy this file to ".env" and fill in your values.
# NEVER commit the real .env file — it contains your MongoDB credentials.
# The connection string must exist ONLY here, never in any source file.

# Port the Express server listens on
PORT=5000

# MongoDB connection string
# Paste your own connection string after the equals sign, for example:
#   MONGODB_URI=mongodb://127.0.0.1:27017/mortgagewebsite  (local MongoDB)
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mortgagewebsite  (Atlas)
MONGODB_URI=

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173

# JWT signing secret (required for authentication).
# Put a long random value here. Never reuse the MongoDB credentials.
JWT_SECRET=

# How long an auth session lasts (node's vercel ms format).
JWT_EXPIRES_IN=8h
